# polybot secrets — copy to `.env` and fill in. NEVER commit the real .env.
# Only required for LIVE trading. Paper mode and scans need none of these.

# Private key of the wallet that signs orders (hex, with or without 0x).
POLY_PRIVATE_KEY=

# USDC-holding proxy/Safe wallet address (Polymarket "browser wallet" flow).
# Leave blank if trading directly from the EOA that owns POLY_PRIVATE_KEY.
POLY_FUNDER_ADDRESS=

# Optional: pre-derived CLOB L2 API credentials. If omitted, they are derived
# automatically from the private key on first run.
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_PASSPHRASE=
